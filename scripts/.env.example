# Settlement crank + admin scripts. Copy to scripts/.env and `set -a; . ./.env`.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# House authority / cranker keypair (defaults to ~/.config/solana/id.json)
KEYPAIR=/home/you/.config/solana/id.json
# Chain file generated by `npm run generate-chain` (the house's only secret)
CHAIN_FILE=settle/data/chain.json
HEALTH_PORT=8788
POLL_MS=5000
TREASURY_SOL=10
